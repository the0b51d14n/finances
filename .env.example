# Copiez ce fichier en .env.local (développement) et renseignez les mêmes
# variables dans Vercel (Project Settings → Environment Variables).
# Ces deux variables sont SECRÈTES et lues uniquement par le serveur :
# ne les préfixez jamais par NEXT_PUBLIC_ et ne les commitez jamais.

# Neon → votre projet → Connect → chaîne de connexion (« Pooled connection »).
DATABASE_URL=postgresql://utilisateur:mot_de_passe@ep-exemple-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clé de signature des cookies de session, 32 caractères minimum. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# La changer déconnecte toutes les sessions ouvertes.
AUTH_SECRET=remplacez_par_une_valeur_aleatoire_de_32_caracteres_minimum
